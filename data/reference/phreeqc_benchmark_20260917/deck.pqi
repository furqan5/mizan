TITLE Mizan chemistry engine benchmark, pre-registered in docs/staged/phreeqc_benchmark_preregistration.md
PRINT
 -reset false
SELECTED_OUTPUT 1
 -file selected.tsv
 -reset false
 -high_precision true
USER_PUNCH 1
 -headings id T_C pH mu pct_err Ca S6 C4 Si P alk hco3_sum si_calcite si_gypsum si_silica si_hap lk_calcite lk_gypsum lk_silica lk_hap lg_ca lg_so4 lg_hco3 lg_h4sio4 lg_hpo4
 -start
 10 PUNCH CELL_NO, TC, -LA("H+"), MU, PERCENT_ERROR
 20 PUNCH TOT("Ca"), TOT("S(6)"), TOT("C(4)"), TOT("Si"), TOT("P"), ALK
 30 PUNCH MOL("HCO3-") + MOL("CaHCO3+") + MOL("MgHCO3+") + MOL("NaHCO3") + MOL("KHCO3")
 40 PUNCH SI("Calcite"), SI("Gypsum"), SI("SiO2(a)"), SI("Hydroxyapatite")
 50 PUNCH LK_PHASE("Calcite"), LK_PHASE("Gypsum"), LK_PHASE("SiO2(a)"), LK_PHASE("Hydroxyapatite")
 60 PUNCH LG("Ca+2"), LG("SO4-2"), LG("HCO3-"), LG("H4SiO4"), LG("HPO4-2")
 -end
