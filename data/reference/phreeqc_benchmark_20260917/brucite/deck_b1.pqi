TITLE Mizan brucite supplement, run B1, wateq4f.dat
PRINT
 -reset false
SELECTED_OUTPUT 1
 -file selected_b1.tsv
 -reset false
 -high_precision true
USER_PUNCH 1
 -headings id T_C pH mu si_brucite lk_brucite lk_oh Mg_total Mg_free lg_mg
 -start
 10 PUNCH CELL_NO, TC, -LA("H+"), MU, SI("Brucite")
 20 PUNCH LK_PHASE("Brucite"), LK_SPECIES("OH-"), TOT("Mg"), MOL("Mg+2"), LG("Mg+2")
 -end
